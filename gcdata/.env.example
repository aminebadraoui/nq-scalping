GOCHARTING_EMAIL=you@example.com
GOCHARTING_PASSWORD=your-password
GOCHARTING_COGNITO_CLIENT=3fqhvm22ea8pjsr2spbnv484pr
GOCHARTING_COGNITO_POOL=ap-south-1_uuM8MRslb
GOCHARTING_DC=nyc1
GOCHARTING_SYMBOL=NQZ26
# ES front month (DOM_V2 cross-asset book) — optional: derived from
# GOCHARTING_SYMBOL via the shared H/M/U/Z quarterly cycle when unset.
#GOCHARTING_SYMBOL_ES=ESZ26
GOCHARTING_EXCHANGE=CME
GOCHARTING_SEGMENT=FUTURE
# Telegram alerts (bot created via @BotFather). The chat id is optional: for a
# personal bot, message the bot once and it will auto-discover your private
# chat. Set TELEGRAM_CHAT_ID to pin it (required in Coolify/production).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Cloudflare R2 historical archive (scripts/r2_sync.py upload/prune — nightly).
# Create the S3-compatible token in the R2 dashboard (Manage R2 API Tokens).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nq-history
# Public base URL of the bucket (bucket → Settings → Public Access → r2.dev):
# GC_REMOTE_URL=https://pub-xxxxxxxxxxxx.r2.dev  (also set this in web/.env.local
# and the Coolify app env so the dashboard serves history from R2)
