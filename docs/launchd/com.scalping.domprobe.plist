<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Sunday-evening DOM_V2 schema capture: runs at 18:05 local (US Eastern —
  Globex reopens Sundays at 18:00 NY) and records 10 minutes of raw frames
  from the dedicated wsdom socket to gcdata/data/dom_probe_launchd.log.

  Purpose: validate the reverse-engineered DOM_V2 decoder (web/lib/dom.ts)
  against real live frames, and keep a tiny weekly L2 sample.

  Install:
    cp docs/launchd/com.scalping.domprobe.plist ~/Library/LaunchAgents/
    launchctl unload ~/Library/LaunchAgents/com.scalping.domprobe.plist 2>/dev/null
    launchctl load ~/Library/LaunchAgents/com.scalping.domprobe.plist
    (macOS 13+: launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.scalping.domprobe.plist)

  Run once by hand:
    launchctl start com.scalping.domprobe
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.scalping.domprobe</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/amean/PROJECTS/DEV/Scalping/gcdata/.venv/bin/python</string>
        <string>/Users/amean/PROJECTS/DEV/Scalping/gcdata/probe_dom.py</string>
        <string>--seconds</string>
        <string>600</string>
        <string>--out</string>
        <string>/Users/amean/PROJECTS/DEV/Scalping/gcdata/data/dom_probe_launchd.log</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/amean/PROJECTS/DEV/Scalping/gcdata</string>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>18</integer><key>Minute</key><integer>5</integer></dict>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/amean/PROJECTS/DEV/Scalping/gcdata/data/dom_probe_launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/amean/PROJECTS/DEV/Scalping/gcdata/data/dom_probe_launchd.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
