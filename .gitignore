# ---- credentials: NEVER commit ----
gcdata/.env
web/.env
web/.env.local
web/.env.*.local

# live deploy credentials live in this skill (Coolify token, Neon API key)
.agents/skills/coolify-deploy/

# ---- executor runtime state (account guard high-water mark) ----
web/.executor-guard.json

# ---- collected feed data (regenerable; Neon Postgres is the store) ----
# the big sweep JSONs stay local; the small audit reports + trial ledger +
# frozen-holdout pins ship so the deployed dashboard can render them
gcdata/data/*
!gcdata/data/sweeps/
!gcdata/data/trials.json
!gcdata/data/holdouts.json
gcdata/data/sweeps/*
!gcdata/data/sweeps/*.validation.json
gcdata/ingest_log.txt

# ---- environments & caches ----
gcdata/.venv/
.npm-cache/
__pycache__/
*.pyc
*.tsbuildinfo
web/node_modules/
web/.next/
web/next-env.d.ts

# ---- misc ----
.DS_Store
.runner-state.json
