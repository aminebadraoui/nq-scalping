#!/usr/bin/env bash
# Pre-push hook: block pushes that change live-execution files without
# [backtested:] evidence, and run types+tests on every such push.
# Install: bash scripts/install-hooks.sh
# Bypass (deliberate): ALLOW_UNVALIDATED_EXEC=1 git push ...
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
z40=0000000000000000000000000000000000000000
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  base="$remote_sha"
  if [ "$remote_sha" = "$z40" ]; then
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null || echo "$local_sha~1")
  fi
  out=$(bash scripts/exec-gate.sh "$base" "$local_sha" 2>&1)
  status=$?
  protected=0
  if printf '%s' "$out" | grep -q '^protected files changed:'; then protected=1; fi
  if [ "$status" -ne 0 ]; then
    if [ "${ALLOW_UNVALIDATED_EXEC:-0}" = "1" ]; then
      echo "WARNING: execution gate bypassed via ALLOW_UNVALIDATED_EXEC=1" >&2
    else
      printf '%s\n' "$out" >&2
      blocked=1
    fi
  fi
  if [ "$status" -eq 0 ] && [ "$protected" -eq 1 ]; then
    echo "> running types + tests for the live-execution change…"
    (cd web && npx tsc --noEmit) || { echo "tsc failed — push blocked" >&2; blocked=1; }
    (cd web && npm test >/dev/null 2>&1) || { echo "tests failed — push blocked" >&2; blocked=1; }
  fi
done

if [ "$blocked" -eq 1 ]; then
  echo >&2
  echo "Push blocked. See web/EXEC_CHANGE_POLICY.md." >&2
  echo "Deliberate override: ALLOW_UNVALIDATED_EXEC=1 git push …" >&2
  exit 1
fi
exit 0
